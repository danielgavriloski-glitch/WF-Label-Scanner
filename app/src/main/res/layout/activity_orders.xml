<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F5F5F5"
    android:orientation="vertical"
    android:padding="14dp">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical" android:orientation="horizontal">
        <TextView android:layout_width="58dp" android:layout_height="58dp" android:background="@drawable/wf_logo_tile" android:gravity="center" android:text="WF" android:textColor="#000000" android:textSize="24sp" android:textStyle="bold" />
        <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_marginStart="12dp" android:layout_weight="1" android:text="НАЛОЗИ / ДОКУМЕНТИ" android:textColor="#111111" android:textSize="20sp" android:textStyle="bold" />
    </LinearLayout>
    <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:paddingVertical="10dp" android:text="Подредени од најнов кон најстар. Допри налог за преглед и измена." android:textColor="#666666" />
    <ListView android:id="@+id/ordersList" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:divider="@android:color/transparent" android:dividerHeight="8dp" />
    <Button android:id="@+id/closeOrdersButton" style="@style/WFPrimaryButton" android:text="НАЗАД" />
</LinearLayout>
